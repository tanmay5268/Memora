{
  "name": "@workspace/orpc",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./client": {
      "types": "./dist/client/orpcClient.d.ts",
      "default": "./dist/client/orpcClient.js"
    },
    "./security": {
      "types": "./dist/security/rate-limit.d.ts",
      "default": "./dist/security/rate-limit.js"
    }
  },
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch"
  },
  "dependencies": {
    "@orpc/server": "beta",
    "@orpc/client": "beta",
    "zod": "latest",
    "drizzle-orm": "latest",
    "@workspace/db": "workspace:*",
    "@workspace/auth": "workspace:*",
    "@workspace/cache": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22",
    "@workspace/typescript-config": "workspace:*",
    "typescript": "latest"
  }
}