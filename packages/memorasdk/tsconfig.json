{
  "extends": "@workspace/typescript-config/base.json",
  "compilerOptions": {
      "lib": ["ES2022","DOM"],
      "module": "esnext",
      "target": "es2022",
      "moduleResolution": "bundler",
      "esModuleInterop":true,
      "isolatedModules": true,
      "resolveJsonModule":true,
      "noEmit": true,
      "strict": true,
      "skipLibCheck": true,
      "jsx": "preserve",
    },
    "include": ["src/**/*"],
    "exclude": ["node_modules"]
 
}